---
import { i18n, navItems, type Locale } from '../data/site';

interface Props {
  locale: Locale;
  localizedPath: string;
}

const { locale, localizedPath } = Astro.props;
const text = i18n[locale];
const currentPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const localePrefix = locale === 'en' ? '/en' : '';
---

<header class="site-header" data-header data-show="true">
  <div class="header-inner">
    <a class="brand" href={`${localePrefix}/`} aria-label="Jinhui Luo home">
      <span class="brand-copy"><strong>Jinhui Luo</strong><small>{locale === 'zh' ? '学术主页' : 'Academic homepage'}</small></span>
    </a>
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="primary-nav">
      <span class="sr-only">{text.menu}</span><span class="menu-lines" aria-hidden="true"></span>
    </button>
    <nav id="primary-nav" class="primary-nav" data-mobile-nav aria-label="Primary navigation">
      {navItems.map((item) => {
        const href = item.href === '/' ? `${localePrefix}/` : `${localePrefix}${item.href}`;
        const active = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return <a class:list={{ active }} href={href}>{item[locale]}</a>;
      })}
      <a class="language-link" href={localizedPath} aria-label={text.switchLanguage}>{text.switchLanguage}</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" aria-pressed="false"><span aria-hidden="true">◐</span></button>
    </nav>
  </div>
</header>
