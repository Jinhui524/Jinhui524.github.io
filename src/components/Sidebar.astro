---
import { i18n, profile, quickLinks, type Locale } from '../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const text = i18n[locale];
---

<aside class="sidebar">
  <div class="profile-card">
    <div class="avatar-wrap"><img src={profile.avatar} alt={`${profile.name} profile`} /></div>
    <p class="profile-kicker">{locale === 'zh' ? '个人学术主页' : 'Personal academic homepage'}</p>
    <h1>{profile.name}<span>{profile.nameZh}</span></h1>
    <p class="profile-role">{profile.role[locale]}</p>
    <p class="profile-bio">{profile.motto[locale]}</p>
    <div class="profile-meta"><span>⌖ {profile.location[locale]}</span><span>⌁ HNUST</span></div>
    <div class="social-row">
      <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={profile.scholar} target="_blank" rel="noreferrer">Scholar</a>
    </div>
  </div>
  <div class="side-links">
    <p class="side-label">{text.linksTitle}</p>
    {quickLinks.map((link) => (
      <a class="side-link" href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>
        <span class="side-link-icon">{link.icon}</span><span><strong>{link.label}</strong><small>{link.note[locale]}</small></span><span class="side-link-arrow">↗</span>
      </a>
    ))}
  </div>
</aside>
