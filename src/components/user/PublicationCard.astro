---
import { cn } from '@/utils'
import Icon from './Icon.astro'
import SimpleIcon from './SimpleIcon.astro'

interface Props {
  class?: string
  publication: {
    title: string
    authors: Array<{
      name: string
      isMe?: boolean
      isEqual?: boolean
      isCoreContributor?: boolean
      role?: 'corresponding' | 'project-leader'
      homepage?: string
    }>
    venue: string
    year: string
    type: 'conference' | 'journal' | 'workshop' | 'preprint'
    abstract?: string
    links: { type: string; href: string }[]
    status: 'published' | 'accepted' | 'under-review' | 'preprint'
    citations?: number
    authorsAlphabetical?: boolean
    ranking?: string
    topics?: string[]
    image?: string
    detailHref?: string
    detailLabel?: string
  }
}

const { class: className, publication } = Astro.props

const linkIconMap: Record<string, { type: 'simple' | 'builtin'; icon: string; color?: string }> = {
  pdf: { type: 'builtin', icon: 'document' },
  paper: { type: 'builtin', icon: 'document' },
  arxiv: { type: 'simple', icon: 'arxiv', color: '#B31B1B' },
  code: { type: 'simple', icon: 'github', color: '#181717' },
  github: { type: 'simple', icon: 'github', color: '#181717' },
  video: { type: 'simple', icon: 'youtube', color: '#FF0000' },
  poster: { type: 'builtin', icon: 'image' },
  slides: { type: 'builtin', icon: 'presentation' },
  ieee: { type: 'simple', icon: 'ieee', color: '#00629B' },
  acm: { type: 'simple', icon: 'acm', color: '#0085CA' },
  springer: { type: 'simple', icon: 'springer', color: '#FFCC33' },
  pytorch: { type: 'simple', icon: 'pytorch', color: '#EE4C2C' },
  tensorflow: { type: 'simple', icon: 'tensorflow', color: '#FF6F00' },
  model: { type: 'simple', icon: 'huggingface', color: '#FFD21E' },
  huggingface: { type: 'simple', icon: 'huggingface', color: '#FFD21E' },
  hf: { type: 'simple', icon: 'huggingface', color: '#FFD21E' },
  website: { type: 'builtin', icon: 'earth' },
  site: { type: 'builtin', icon: 'earth' },
  dataset: { type: 'simple', icon: 'huggingface', color: '#FFD21E' },
}

const typeLabels = {
  conference: 'Conference',
  journal: 'Journal',
  workshop: 'Workshop',
  preprint: 'Preprint'
} as const

const typeClasses = {
  conference: 'publication-badge publication-badge--conference',
  journal: 'publication-badge publication-badge--journal',
  workshop: 'publication-badge publication-badge--workshop',
  preprint: 'publication-badge publication-badge--preprint'
} as const

const statusLabels = {
  published: 'Published',
  accepted: 'Accepted',
  'under-review': 'Under Review',
  preprint: 'Preprint'
} as const

const statusClasses = {
  published: 'publication-badge publication-badge--published',
  accepted: 'publication-badge publication-badge--accepted',
  'under-review': 'publication-badge publication-badge--review',
  preprint: 'publication-badge publication-badge--preprint'
} as const

const symbolBaseClass = 'text-primary dark:text-blue-400'
const symbolMutedClass = 'text-muted-foreground/80 dark:text-slate-400/80'

const getLinkLabel = (type: string) => {
  const normalized = type.toLowerCase()
  if (['pdf', 'paper', 'arxiv', 'ieee', 'acm', 'springer'].includes(normalized)) return 'Paper'
  if (['code', 'github'].includes(normalized)) return 'Code'
  if (['website', 'site'].includes(normalized)) return 'Website'
  if (normalized === 'dataset') return 'Dataset'
  if (normalized === 'slides') return 'Slides'
  if (normalized === 'poster') return 'Poster'
  if (normalized === 'video') return 'Video'
  return type.charAt(0).toUpperCase() + type.slice(1)
}

const hasAuthorNotes = publication.authors.some((author) => author.isEqual || author.isCoreContributor || author.role)
---

<article class={cn('publication-card group', className)}>
  <div class='publication-card__layout'>
    {
      publication.image && (
        <div class='publication-card__media'>
          {
            publication.detailHref ? (
              <a href={publication.detailHref} aria-label={`View details for ${publication.title}`} class='publication-card__media-link'>
                <img src={publication.image} alt={`${publication.title} framework`} loading='lazy' decoding='async' />
                <span class='publication-card__media-hint' aria-hidden='true'>↗</span>
              </a>
            ) : (
              <div class='publication-card__media-link'>
                <img src={publication.image} alt={`${publication.title} framework`} loading='lazy' decoding='async' />
              </div>
            )
          }
        </div>
      )
    }

    <div class='publication-card__body'>
      <div class='publication-card__badges' aria-label='Publication metadata'>
        <span class={typeClasses[publication.type]}>{typeLabels[publication.type]}</span>
        <span class={statusClasses[publication.status]}>{statusLabels[publication.status]}</span>
      </div>

      <h3 class='publication-card__title'>
        {
          publication.detailHref ? (
            <a href={publication.detailHref} class='publication-card__title-link'>{publication.title}</a>
          ) : (
            publication.title
          )
        }
      </h3>

      {publication.authors.length > 0 && (
        <p class='publication-card__authors'>
          {publication.authors.map((author, index) => (
            <span class='author-item'>
              {author.homepage ? (
                <a href={author.homepage} target='_blank' rel='noopener noreferrer' class={author.isMe ? 'author-name author-name--me' : 'author-name'}>{author.name}</a>
              ) : (
                <span class={author.isMe ? 'author-name author-name--me' : 'author-name'}>{author.name}</span>
              )}
              {author.isEqual && <sup class={cn(symbolBaseClass, 'ml-px')}>*</sup>}
              {author.isCoreContributor && <sup class={cn(symbolBaseClass, 'ml-px')}>§</sup>}
              {author.role === 'corresponding' && <sup class={cn(symbolBaseClass, 'ml-px')}>†</sup>}
              {author.role === 'project-leader' && <sup class={cn(symbolBaseClass, 'ml-px')}>‡</sup>}
              {index < publication.authors.length - 1 && <span class='text-muted-foreground/60 dark:text-slate-400/60'>, </span>}
            </span>
          ))}
        </p>
      )}

      {hasAuthorNotes && (
        <div class={cn('publication-card__notes', symbolMutedClass)}>
          {publication.authors.some((author) => author.isMe) && <span><strong class='text-foreground dark:text-slate-200'>Jinhui Luo</strong> is highlighted</span>}
          {publication.authors.some((author) => author.isEqual) && <span><sup class={symbolBaseClass}>*</sup> Equal contribution</span>}
          {publication.authors.some((author) => author.isCoreContributor) && <span><sup class={symbolBaseClass}>§</sup> Core contributor</span>}
          {publication.authors.some((author) => author.role === 'project-leader') && <span><sup class={symbolBaseClass}>‡</sup> Project leader</span>}
          {publication.authors.some((author) => author.role === 'corresponding') && <span><sup class={symbolBaseClass}>†</sup> Corresponding author</span>}
          {publication.authorsAlphabetical && <span class='italic'>Authors are listed alphabetically</span>}
        </div>
      )}

      {publication.abstract && <p class='publication-card__abstract'>{publication.abstract}</p>}

      <div class='publication-card__venue'>
        <span class='publication-card__venue-name'>{publication.venue}</span>
        <span aria-hidden='true'>·</span>
        <time datetime={publication.year}>{publication.year}</time>
      </div>

      {publication.topics && publication.topics.length > 0 && (
        <div class='publication-card__topics' aria-label='Research topics'>
          {publication.topics.map((topic) => <span>{topic}</span>)}
        </div>
      )}

      {
        (publication.ranking || (publication.links && publication.links.length > 0) || publication.detailHref) && (
          <div class='publication-card__footer'>
            {publication.ranking && <span class='publication-badge publication-badge--ranking'>{publication.ranking}</span>}
            <div class='publication-card__actions'>
            {publication.links.map((link) => {
              const normalizedType = link.type.toLowerCase()
              const iconConfig = linkIconMap[normalizedType] || { type: 'builtin', icon: 'earth' }
              const label = getLinkLabel(link.type)
              return (
                <a href={link.href} target='_blank' rel='noopener noreferrer' class='publication-action-link'>
                  {iconConfig.type === 'simple' ? (
                    <SimpleIcon class='size-3.5' name={iconConfig.icon} color={iconConfig.color || 'currentColor'} />
                  ) : (
                    <Icon class='size-3.5 text-current' name={iconConfig.icon as any} />
                  )}
                  <span>{label}</span>
                </a>
              )
            })}
            {publication.detailHref && (
              <a href={publication.detailHref} class='publication-action-link publication-action-link--details'>
                <span>{publication.detailLabel || 'Details'}</span>
                <span aria-hidden='true'>↗</span>
              </a>
            )}
            </div>
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .publication-card {
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-card);
    padding: 1rem;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .publication-card:hover {
    border-color: color-mix(in srgb, var(--color-primary) 30%, var(--color-border));
    box-shadow: 0 12px 30px rgb(15 23 42 / 0.07);
    transform: translateY(-1px);
  }

  .publication-card__layout {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .publication-card__media { width: 100%; }

  .publication-card__media-link {
    position: relative;
    display: flex;
    min-height: 12rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-muted) 42%, transparent);
  }

  .publication-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 18rem;
    object-fit: contain;
    padding: 0.45rem;
    transition: transform 300ms ease;
  }

  .publication-card:hover .publication-card__media img { transform: scale(1.025); }

  .publication-card__media-hint {
    position: absolute;
    right: 0.55rem;
    top: 0.55rem;
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-border) 75%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-card) 88%, transparent);
    color: var(--color-muted-foreground);
    font-size: 0.75rem;
    opacity: 0;
    transform: translateY(-0.25rem);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .publication-card:hover .publication-card__media-hint,
  .publication-card__media-link:focus-visible .publication-card__media-hint { opacity: 1; transform: translateY(0); }
  .publication-card__body { min-width: 0; }
  .publication-card__badges, .publication-card__topics, .publication-card__actions, .publication-card__footer { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; }
  .publication-card__badges { margin-bottom: 0.7rem; }

  .publication-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    border: 1px solid transparent;
    border-radius: 9999px;
    padding: 0.25rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  .publication-badge--conference, .publication-badge--accepted { border-color: color-mix(in srgb, #0ea5e9 22%, var(--color-border)); background: color-mix(in srgb, #0ea5e9 10%, transparent); color: color-mix(in srgb, #0284c7 85%, var(--color-foreground)); }
  .publication-badge--journal, .publication-badge--published { border-color: color-mix(in srgb, #10b981 22%, var(--color-border)); background: color-mix(in srgb, #10b981 10%, transparent); color: color-mix(in srgb, #059669 85%, var(--color-foreground)); }
  .publication-badge--workshop, .publication-badge--review { border-color: color-mix(in srgb, #f59e0b 24%, var(--color-border)); background: color-mix(in srgb, #f59e0b 11%, transparent); color: color-mix(in srgb, #b45309 85%, var(--color-foreground)); }
  .publication-badge--preprint { border-color: color-mix(in srgb, var(--color-muted-foreground) 25%, var(--color-border)); background: color-mix(in srgb, var(--color-muted) 75%, transparent); color: var(--color-muted-foreground); }
  .publication-badge--ranking { border-color: color-mix(in srgb, var(--color-primary) 30%, var(--color-border)); background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary); }

  .publication-card__title { margin: 0; color: var(--color-foreground); font-size: clamp(1.05rem, 1.8vw, 1.28rem); font-weight: 600; letter-spacing: -0.01em; line-height: 1.35; }
  .publication-card__title-link { text-decoration: none; transition: color 180ms ease; }
  .publication-card__title-link:hover, .publication-card__title-link:focus-visible { color: var(--color-primary); }
  .publication-card__authors { margin: 0.6rem 0 0; color: var(--color-muted-foreground); font-size: 0.82rem; line-height: 1.65; }
  .author-name--me { color: var(--color-foreground); font-weight: 650; }
  .author-name:hover, .author-name:focus-visible { color: var(--color-primary); text-decoration: underline; text-underline-offset: 0.15em; }
  .publication-card__notes { display: flex; flex-wrap: wrap; gap: 0.35rem 0.8rem; margin-top: 0.4rem; font-size: 0.68rem; line-height: 1.5; }
  .publication-card__abstract { max-width: 72ch; margin: 0.8rem 0 0; color: var(--color-muted-foreground); font-size: 0.84rem; line-height: 1.7; }
  .publication-card__venue { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; margin-top: 0.8rem; color: var(--color-muted-foreground); font-size: 0.78rem; }
  .publication-card__venue-name { color: var(--color-foreground); font-weight: 600; }
  .publication-card__topics { margin-top: 0.7rem; }
  .publication-card__topics span { border-radius: 9999px; background: color-mix(in srgb, var(--color-muted) 72%, transparent); color: var(--color-muted-foreground); font-size: 0.66rem; line-height: 1; padding: 0.3rem 0.5rem; }
  .publication-card__footer { margin-top: 1rem; justify-content: space-between; gap: 0.7rem; }
  .publication-card__actions { margin-top: 0; gap: 0.45rem; }

  .publication-action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-muted) 45%, transparent);
    color: var(--color-muted-foreground);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.45rem 0.6rem;
    text-decoration: none;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .publication-action-link:hover, .publication-action-link:focus-visible { border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border)); background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary); transform: translateY(-1px); }
  .publication-action-link--details { border-color: color-mix(in srgb, var(--color-primary) 25%, var(--color-border)); background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary); }
  .publication-card :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

  @media (min-width: 640px) {
    .publication-card { padding: 1.25rem; }
    .publication-card__layout { grid-template-columns: minmax(13.75rem, 15rem) minmax(0, 1fr); gap: 1.5rem; }
    .publication-card__media-link { min-height: 12rem; height: 100%; }
    .publication-card__media img { max-height: 15rem; }
  }

  @media (max-width: 639px) {
    .publication-card__media-link { min-height: 13rem; }
    .publication-card__media img { max-height: 18rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .publication-card, .publication-card__media img, .publication-card__media-hint, .publication-action-link, .publication-card__title-link { transition: none; }
  }
</style>
