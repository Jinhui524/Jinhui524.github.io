---
import { cn } from '@/utils'

interface SponsorshipMethod {
  name: string
  label: string
  image?: string
  placeholder?: string
}

interface SponsorRecord {
  name: string
  amount?: string
  date?: string
}

interface Props {
  class?: string
  methods: SponsorshipMethod[]
  sponsors?: SponsorRecord[]
  title?: string
  description?: string
  emptyMessage?: string
  sponsorTitle?: string
}

const {
  class: className,
  methods,
  sponsors = [],
  title = 'Sponsorship',
  description = '如果我的研究与开源工作对你有所帮助，欢迎留下支持。二维码会在后续更新。',
  emptyMessage = '目前还没有赞助记录，感谢每一份关注与支持。',
  sponsorTitle = 'Sponsors'
} = Astro.props

const totalAmount = sponsors.reduce((total, sponsor) => {
  const amount = Number.parseFloat((sponsor.amount || '').replace(/[^0-9.]/g, ''))
  return total + (Number.isFinite(amount) ? amount : 0)
}, 0)
---

<section id='sponsorship' class={cn('mt-12 flex flex-col gap-y-6', className)} aria-labelledby='sponsorship-title'>
  <div class='flex flex-col gap-y-2'>
    <h2 id='sponsorship-title' class='text-2xl font-medium sm:text-3xl'>{title}</h2>
    <p class='text-muted-foreground'>{description}</p>
  </div>

  <div class='grid grid-cols-1 gap-5 sm:grid-cols-2'>
    {
      methods.map((method) => (
        <div class='sponsorship-method group relative overflow-hidden rounded-2xl border border-border bg-card p-3 transition-all duration-300 hover:-translate-y-0.5 hover:border-foreground/25 hover:shadow-lg'>
          <div class='relative aspect-[1.35] overflow-hidden rounded-xl border border-border/70 bg-muted/50'>
            {
              method.image ? (
                <img
                  src={method.image}
                  alt={`${method.label} sponsorship QR code`}
                  loading='lazy'
                  class='h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.02]'
                />
              ) : (
                <div class='absolute inset-0 flex flex-col items-center justify-center gap-y-2 bg-gradient-to-br from-muted/80 via-background/60 to-muted/60 text-center'>
                  <div class='placeholder-pattern absolute inset-0 opacity-30' aria-hidden='true' />
                  <span class='relative rounded-full border border-border/80 bg-background/80 px-3 py-1 text-sm font-semibold text-foreground shadow-sm backdrop-blur-sm'>
                    {method.name}
                  </span>
                  <span class='relative text-xs text-muted-foreground'>{method.placeholder || '二维码待补充'}</span>
                </div>
              )
            }
          </div>
          <p class='mt-3 text-center text-sm font-medium text-muted-foreground transition-colors group-hover:text-foreground'>
            {method.label}
          </p>
        </div>
      ))
    }
  </div>

  <div class='mt-2 rounded-2xl border border-border bg-card'>
    <div class='flex items-center justify-between gap-4 border-b border-border px-5 py-4'>
      <h3 class='m-0 text-base font-semibold'>{sponsorTitle} ({sponsors.length})</h3>
      {sponsors.length > 0 ? <span class='text-sm text-muted-foreground'>Total: ¥{totalAmount.toFixed(2)}</span> : <span class='text-sm text-muted-foreground'>Total: ¥0.00</span>}
    </div>
    {
      sponsors.length > 0 ? (
        <ul class='m-0 divide-y divide-border p-0'>
          {sponsors.map((sponsor) => (
            <li class='flex items-center justify-between gap-4 px-5 py-3 text-sm'>
              <span class='font-medium'>{sponsor.name}</span>
              <span class='flex items-center gap-4 text-muted-foreground'>
                {sponsor.amount && <span>{sponsor.amount}</span>}
                {sponsor.date && <time>{sponsor.date}</time>}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class='m-0 px-5 py-4 text-sm text-muted-foreground'>{emptyMessage}</p>
      )
    }
  </div>
</section>

<style>
  .placeholder-pattern {
    background-image: linear-gradient(135deg, hsl(var(--border) / 0.55) 25%, transparent 25%),
      linear-gradient(225deg, hsl(var(--border) / 0.55) 25%, transparent 25%),
      linear-gradient(45deg, hsl(var(--border) / 0.55) 25%, transparent 25%),
      linear-gradient(315deg, hsl(var(--border) / 0.55) 25%, hsl(var(--muted) / 0.55) 25%);
    background-position: 10px 0, 10px 0, 0 0, 0 0;
    background-size: 20px 20px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sponsorship-method,
    .sponsorship-method * {
      transition-duration: 0ms;
    }
  }
</style>
