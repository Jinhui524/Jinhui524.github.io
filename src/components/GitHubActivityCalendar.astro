---
interface Props {
  username: string;
  locale: 'zh' | 'en';
}

const { username, locale } = Astro.props;
---

<section class="github-activity" data-github-activity data-username={username} aria-labelledby="github-activity-title">
  <div class="github-activity__heading">
    <div>
      <p class="github-activity__eyebrow">GitHub activity</p>
      <h3 id="github-activity-title">{locale === 'zh' ? '公开贡献轨迹' : 'Public contribution activity'}</h3>
    </div>
    <a href={`https://github.com/${username}`} target="_blank" rel="noreferrer">@{username} ↗</a>
  </div>
  <div class="github-activity__scroll" role="img" aria-label={locale === 'zh' ? 'GitHub 贡献热力图' : 'GitHub contribution heatmap'}>
    <div class="github-activity__grid" data-activity-grid>
      {Array.from({ length: 371 }, (_, index) => <span class="activity-cell" data-level="0" data-placeholder={index} />)}
    </div>
  </div>
  <footer class="github-activity__footer">
    <span data-activity-summary>{locale === 'zh' ? '正在加载贡献数据…' : 'Loading contribution data…'}</span>
    <span class="github-activity__legend" aria-hidden="true">
      <span>{locale === 'zh' ? '少' : 'Less'}</span>
      <i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i>
      <span>{locale === 'zh' ? '多' : 'More'}</span>
    </span>
  </footer>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-github-activity]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    const grid = root.querySelector('[data-activity-grid]');
    const summary = root.querySelector('[data-activity-summary]');
    const username = root.dataset.username;

    const render = (activities, total, error = false) => {
      if (!grid) return;
      const cells = Array.isArray(activities) ? activities.slice(-371) : [];
      grid.innerHTML = '';
      const fragment = document.createDocumentFragment();
      if (cells.length === 0) {
        for (let i = 0; i < 371; i += 1) {
          const cell = document.createElement('span');
          cell.className = 'activity-cell';
          cell.dataset.level = '0';
          fragment.appendChild(cell);
        }
      } else {
        cells.forEach((activity) => {
          const cell = document.createElement('span');
          cell.className = 'activity-cell';
          cell.dataset.level = String(Math.max(0, Math.min(4, activity.level ?? 0)));
          cell.title = `${activity.count ?? 0} contributions on ${activity.date}`;
          cell.setAttribute('aria-label', cell.title);
          fragment.appendChild(cell);
        });
      }
      grid.appendChild(fragment);
      if (summary) {
        summary.textContent = error
          ? 'GitHub contribution data is unavailable right now.'
          : `${total ?? 0} contributions in the last year`;
      }
    };

    fetch(`https://github-contributions-api.jogruber.de/v4/${encodeURIComponent(username)}?y=last`, { headers: { Accept: 'application/json' } })
      .then((response) => {
        if (!response.ok) throw new Error('Contribution request failed');
        return response.json();
      })
      .then((data) => render(data.contributions, data.total?.lastYear))
      .catch(() => render([], 0, true));
  })();
</script>
