---
interface Props { index: string; eyebrow: string; title: string; action?: string; href?: string }
const { index, eyebrow, title, action, href } = Astro.props;
---

<div class="section-heading">
  <div><span class="section-index">{index}</span><span class="eyebrow">{eyebrow}</span><h2>{title}</h2></div>
  {action && href && <a class="text-link" href={href}>{action} <span aria-hidden="true">↗</span></a>}
</div>
