---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../data/site';

interface Props { publication: CollectionEntry<'publications'>; locale: Locale; compact?: boolean }
const { publication, locale, compact = false } = Astro.props;
const p = publication.data;
const prefix = locale === 'en' ? '/en' : '';
---

<article class:list={['publication-card', { compact }]} data-category={p.category}>
  {p.frameworkImage && !compact && <img class="publication-image" src={p.frameworkImage} alt={p.frameworkAlt ?? p.shortTitle} loading="lazy" />}
  <div class="publication-body">
    <div class="card-topline"><span class="paper-venue">{p.shortVenue}</span><span class="paper-status">{p.status}</span></div>
    <h3><a href={`${prefix}/publications/${p.slug}/`}>{p[locale === 'zh' ? 'titleZh' : 'titleEn']}</a></h3>
    <p class="paper-excerpt">{p[locale === 'zh' ? 'excerptZh' : 'excerptEn']}</p>
    <div class="tag-row">{p.tags.map((tag) => <span>{tag}</span>)}</div>
    <div class="card-meta"><span>{p.level}</span><span>{p.date}</span><a href={`${prefix}/publications/${p.slug}/`}>{locale === 'zh' ? '详情' : 'Details'} ↗</a></div>
  </div>
</article>
