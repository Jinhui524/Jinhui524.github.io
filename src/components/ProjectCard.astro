---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../data/site';

interface Props { project: CollectionEntry<'projects'>; locale: Locale }
const { project, locale } = Astro.props;
const p = project.data;
const prefix = locale === 'en' ? '/en' : '';
---

<article class="project-card">
  <div class="project-card-body">
    <div class="card-topline"><span class="paper-venue">{p[locale === 'zh' ? 'levelZh' : 'levelEn']}</span><span class="project-role">{p[locale === 'zh' ? 'roleZh' : 'roleEn']}</span></div>
    <h3><a href={`${prefix}/projects/${p.slug}/`}>{p[locale === 'zh' ? 'titleZh' : 'titleEn']}</a></h3>
    <p>{p[locale === 'zh' ? 'excerptZh' : 'excerptEn']}</p>
    <div class="tag-row">{p.tags.map((tag) => <span>{tag}</span>)}</div>
    <a class="text-link" href={`${prefix}/projects/${p.slug}/`}>{locale === 'zh' ? '查看项目' : 'View project'} ↗</a>
  </div>
</article>
