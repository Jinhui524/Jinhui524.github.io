---
import { getCollection } from 'astro:content';
import Layout from './Layout.astro';
import AxiSection from './AxiSection.astro';
import ProfileHeader from './ProfileHeader.astro';
import PublicationCard from './PublicationCard.astro';
import ProjectCard from './ProjectCard.astro';
import { education, i18n, profile, researchInterests, stats, type Locale } from '../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const text = i18n[locale];
const prefix = locale === 'en' ? '/en' : '';
const publications = await getCollection('publications');
const projects = await getCollection('projects');
const featuredSlugs = ['llm4ppm', 'fhgsn', 'aligning-graphs'];
const featured = featuredSlugs.map((slug) => publications.find((entry) => entry.data.slug === slug)).filter(Boolean);
---

<Layout locale={locale} description={profile.bio[locale]}>
  <ProfileHeader locale={locale} />
  <div class="axi-content">
    <AxiSection title={text.aboutTitle} id="about">
      <div class="axi-copy">
        <p>{locale === 'zh' ? `我目前就读于${profile.affiliationZh}，专业为数据科学与大数据技术（2023—2027），并在${profile.labZh}开展人工智能研究。` : `I study Data Science and Big Data Technology at ${profile.affiliation} and conduct AI research with the ${profile.lab}.`}</p>
        <p>{locale === 'zh' ? '我的研究关注如何从事件日志中学习结构、语义和时间信息，让预测结果能够被理解、验证并真正帮助流程决策。' : 'My work studies how to learn structural, semantic, and temporal information from event logs so predictions can be understood, validated, and used for better decisions.'}</p>
      </div>
    </AxiSection>

    <AxiSection title={text.educationTitle} id="education">
      <div class="axi-education-list">
        {education.map((item) => <a class="axi-education-card" href={item.link} target="_blank" rel="noreferrer"><div><h3>{item.title[locale]}</h3><p>{item.detail[locale]}</p></div><time>{item.period}</time><span aria-hidden="true">↗</span></a>)}
      </div>
    </AxiSection>

    <AxiSection title={text.researchTitle} id="research">
      <div class="axi-research-list">{researchInterests.map((item) => <span>{item[locale]}</span>)}</div>
    </AxiSection>

    <AxiSection title={text.selectedPubs} id="publications">
      <div class="publication-list axi-publication-list">{featured.map((publication) => publication && <PublicationCard publication={publication} locale={locale} compact />)}</div>
      <a class="axi-more-link" href={`${prefix}/publications/`}>{text.viewAll} <span aria-hidden="true">↗</span></a>
    </AxiSection>

    <AxiSection title={text.selectedProjects} id="projects">
      <div class="project-list axi-project-list">{projects.slice(0, 2).map((project) => <ProjectCard project={project} locale={locale} />)}</div>
      <a class="axi-more-link" href={`${prefix}/projects/`}>{text.viewAll} <span aria-hidden="true">↗</span></a>
    </AxiSection>

    <AxiSection title={text.statsTitle} id="statistics">
      <div class="stats-grid axi-stats-grid">{stats.slice(0, 3).map((stat) => <div class="stat-card"><strong>{stat.value}</strong><span>{stat[locale]}</span></div>)}</div>
    </AxiSection>

    <AxiSection title={text.contact} id="contact">
      <div class="axi-contact"><p>{locale === 'zh' ? '欢迎围绕人工智能、预测性流程监控和科研合作与我交流。' : 'I welcome conversations about AI, predictive process monitoring, and research collaboration.'}</p><a class="button button-primary" href={`mailto:${profile.email}`}>{profile.email} ↗</a></div>
    </AxiSection>
  </div>
</Layout>
