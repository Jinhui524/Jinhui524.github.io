---
import Layout from './Layout.astro';
import SectionHeading from './SectionHeading.astro';
import { awards, education, i18n, profile, researchInterests, type Locale } from '../data/site';
import { getCollection } from 'astro:content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const text = i18n[locale];
const prefix = locale === 'en' ? '/en' : '';
const publications = await getCollection('publications');
const projects = await getCollection('projects');
---
<Layout locale={locale} title="CV" wide><article class="cv-page reveal"><section class="cv-hero"><p class="hero-eyebrow"><span class="pulse-dot"></span>{locale === 'zh' ? '学术简历 · Graduate outreach' : 'Academic CV · Graduate outreach'}</p><h2>{profile.name}<span>{profile.nameZh}</span></h2><p>{locale === 'zh' ? `湖南科技大学数据科学与大数据技术本科生（2023—2027），在${profile.labZh}开展人工智能与预测性流程监控研究。` : `Undergraduate student in Data Science and Big Data Technology at ${profile.affiliation}, researching AI and predictive process monitoring with the ${profile.lab}.`}</p><div class="hero-actions"><a class="button button-primary" href={`mailto:${profile.email}`}>{text.contact} <span>↗</span></a><a class="button button-quiet" href={`${prefix}/cv/`}>{locale === 'zh' ? '打印/保存 PDF' : 'Print / save PDF'} <span>↓</span></a></div></section><section class="content-section"><SectionHeading index="01" eyebrow="Focus" title={text.researchTitle} /><div class="cv-chip-list">{researchInterests.map((item) => <span>{item[locale]}</span>)}</div></section><section class="content-section"><SectionHeading index="02" eyebrow="Education" title={text.educationTitle} /><div class="timeline">{education.map((item) => <a class="timeline-item" href={item.link} target="_blank" rel="noreferrer"><span class="timeline-period">{item.period}</span><span class="timeline-dot"></span><span class="timeline-copy"><strong>{item.title[locale]}</strong><small>{item.detail[locale]}</small></span><span class="timeline-arrow">↗</span></a>)}</div></section><section class="content-section"><SectionHeading index="03" eyebrow="Output" title={text.selectedPubs} /><div class="cv-simple-list">{publications.map((item) => <a href={`${prefix}/publications/${item.data.slug}/`}><span>{item.data.date}</span><strong>{item.data[locale === 'zh' ? 'titleZh' : 'titleEn']}</strong><small>{item.data.shortVenue} · {item.data.status}</small></a>)}</div></section><section class="content-section"><SectionHeading index="04" eyebrow="Recognition" title={text.awardsTitle} /><div class="award-list">{awards.map((award) => <div class="award-item"><span class="award-index">✦</span><span class="award-title">{award[locale]}</span><span class="award-level">{award.level}</span></div>)}</div></section><section class="content-section"><SectionHeading index="05" eyebrow="Build" title={text.selectedProjects} /><div class="cv-simple-list">{projects.map((item) => <a href={`${prefix}/projects/${item.data.slug}/`}><span>01</span><strong>{item.data[locale === 'zh' ? 'titleZh' : 'titleEn']}</strong><small>{item.data[locale === 'zh' ? 'roleZh' : 'roleEn']}</small></a>)}</div></section></article></Layout>
