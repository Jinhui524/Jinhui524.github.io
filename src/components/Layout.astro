---
import Header from './Header.astro';
import { ClientRouter } from 'astro:transitions';
import { i18n, profile, type Locale } from '../data/site';
import '../styles/global.css';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  wide?: boolean;
}

const { locale = 'zh', title, description, wide = false } = Astro.props;
const text = i18n[locale];
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.nameZh}`;
const pageDescription = description ?? profile.bio[locale];
const otherLocale = locale === 'zh' ? 'en' : 'zh';
const path = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const isNotFound = path.startsWith('/404');
const localizedPath = isNotFound ? (otherLocale === 'en' ? '/en/' : '/') : (otherLocale === 'en' ? `/en${path === '/' ? '/' : path}` : path);
---

<!doctype html>
<html lang={locale} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="hsl(210 33% 99%)" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/images/favicon.svg" />
    <link rel="alternate" hreflang={otherLocale} href={localizedPath} />
    <title>{pageTitle}</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch (_) {}
        const dark = saved === 'dark' || (!saved && window.matchMedia?.('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', Boolean(dark));
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <div class="site-shell">
      <Header locale={locale} localizedPath={localizedPath} />
      <main id="main-content" class:list={['main-content', { 'main-content--wide': wide }]}>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {profile.name} · {text.footer}</span>
        <a href="https://github.com/Jinhui524/Jinhui524.github.io" target="_blank" rel="noreferrer">GitHub ↗</a>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const pageRoot = document.documentElement;
        if (pageRoot.dataset.axiGlobalInteractions === 'true') return;
        pageRoot.dataset.axiGlobalInteractions = 'true';
        const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
        let previousY = window.scrollY;
        let ticking = false;

        const showToast = (message) => {
          document.querySelector('.site-toast')?.remove();
          const toast = document.createElement('div');
          toast.className = 'site-toast';
          toast.setAttribute('role', 'status');
          toast.textContent = message;
          document.body.appendChild(toast);
          window.setTimeout(() => toast.remove(), 2200);
        };

        const setTheme = (theme, announce = false) => {
          const dark = theme === 'dark';
          pageRoot.classList.toggle('dark', dark);
          pageRoot.dataset.theme = dark ? 'dark' : 'light';
          document.querySelector('[data-theme-toggle]')?.setAttribute('aria-pressed', String(dark));
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? 'hsl(240 20% 5%)' : 'hsl(210 33% 99%)');
          try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (_) {}
          if (announce) showToast(`Set theme to ${dark ? 'dark' : 'light'}`);
        };

        const setMenu = (open) => {
          const header = document.querySelector('[data-header]');
          const menu = document.querySelector('[data-mobile-nav]');
          const menuButton = document.querySelector('[data-menu-toggle]');
          menu?.classList.toggle('is-open', open);
          header?.classList.toggle('is-menu-open', open);
          menuButton?.setAttribute('aria-expanded', String(open));
          if (open) header?.setAttribute('data-show', 'true');
        };

        const updateHeader = () => {
          const header = document.querySelector('[data-header]');
          const y = window.scrollY;
          const movingUp = y < previousY;
          header?.classList.toggle('is-scrolled', y > 20);
          if (!header?.classList.contains('is-menu-open')) header?.setAttribute('data-show', String(y < 600 || movingUp));
          previousY = y;
          ticking = false;
        };

        const onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(updateHeader);
            ticking = true;
          }
        };

        const addRipple = (event) => {
          const target = event.target.closest('a, button');
          if (!target || reducedMotion) return;
          target.classList.add('is-pressed');
          window.setTimeout(() => target.classList.remove('is-pressed'), 140);
          const rect = target.getBoundingClientRect();
          const ripple = document.createElement('span');
          ripple.className = 'click-ripple';
          ripple.style.left = `${event.clientX - rect.left}px`;
          ripple.style.top = `${event.clientY - rect.top}px`;
          target.appendChild(ripple);
          window.setTimeout(() => ripple.remove(), 520);
        };

        const onLinkClick = (event) => {
          const link = event.target.closest('a');
          if (!link || reducedMotion || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          if (link.target === '_blank' || link.href.startsWith('mailto:') || link.origin !== window.location.origin) return;
          const nextUrl = new URL(link.href);
          if (nextUrl.pathname === window.location.pathname && nextUrl.hash) return;
          document.body.classList.add('is-leaving');
        };

        const bindPage = () => {
          const themeButton = document.querySelector('[data-theme-toggle]');
          const menuButton = document.querySelector('[data-menu-toggle]');
          const menu = document.querySelector('[data-mobile-nav]');
          if (themeButton && themeButton.dataset.bound !== 'true') {
            themeButton.dataset.bound = 'true';
            themeButton.addEventListener('click', () => setTheme(pageRoot.classList.contains('dark') ? 'light' : 'dark', true));
          }
          if (menuButton && menuButton.dataset.bound !== 'true') {
            menuButton.dataset.bound = 'true';
            menuButton.addEventListener('click', () => setMenu(!document.querySelector('[data-mobile-nav]')?.classList.contains('is-open')));
          }
          menu?.querySelectorAll('a').forEach((link) => {
            if (link.dataset.bound === 'true') return;
            link.dataset.bound = 'true';
            link.addEventListener('click', () => setMenu(false));
          });
          document.body.classList.remove('is-leaving');
          previousY = window.scrollY;
          updateHeader();
        };

        setTheme(pageRoot.classList.contains('dark') ? 'dark' : 'light');
        window.addEventListener('scroll', onScroll, { passive: true });
        document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });
        document.addEventListener('focusin', (event) => { if (document.querySelector('[data-header]')?.contains(event.target)) document.querySelector('[data-header]')?.setAttribute('data-show', 'true'); });
        document.addEventListener('pointerdown', addRipple, { passive: true });
        document.addEventListener('click', onLinkClick);
        document.addEventListener('click', (event) => { if (!document.querySelector('[data-header]')?.contains(event.target)) setMenu(false); });
        document.addEventListener('astro:page-load', bindPage);
        bindPage();
      })();
    </script>
  </body>
</html>
