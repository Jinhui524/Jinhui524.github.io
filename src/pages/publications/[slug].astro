---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { i18n } from '../../data/site';
export async function getStaticPaths() { return (await getCollection('publications')).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } })); }
const { entry } = Astro.props;
const p = entry.data;
const locale = 'zh';
---
<Layout locale={locale} title={p.titleZh} description={p.excerptZh} wide><article class="detail-page reveal"><a class="back-link" href="/publications/">← {i18n.zh.back}</a><div class="detail-header"><div class="card-topline"><span class="paper-venue">{p.shortVenue}</span><span class="paper-status">{p.status}</span></div><h2>{p.titleZh}</h2><p class="detail-subtitle">{p.authors}</p><div class="detail-meta"><span>{p.venue}</span><span>{p.level}</span><span>{p.date}</span></div></div>{p.frameworkImage && <figure class="detail-figure"><img src={p.frameworkImage} alt={p.frameworkAlt} /><figcaption>{p.shortTitle} · framework overview</figcaption></figure>}<div class="detail-grid"><section><p class="detail-label">{i18n.zh.overview}</p><p>{p.overviewZh}</p></section><section><p class="detail-label">{i18n.zh.contribution}</p><p>{p.contributionZh}</p></section></div><div class="tag-row detail-tags">{p.tags.map((tag) => <span>{tag}</span>)}</div></article></Layout>
