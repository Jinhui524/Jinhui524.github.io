---
import Layout from '../../components/Layout.astro';
import AxiSection from '../../components/AxiSection.astro';
import ProfileHeader from '../../components/ProfileHeader.astro';
import { education, profile, researchInterests } from '../../data/site';
const locale = 'zh';
---
<Layout locale={locale} title="关于我" wide><ProfileHeader locale={locale} /><AxiSection title="关于我" id="about"><div class="axi-copy"><p>我目前是湖南科技大学数据科学与大数据技术专业大四学生，并进入东南大学硕士阶段（研0）。</p><p>我的研究关注图数据挖掘、图神经网络、大语言模型、Agent 与事件序列预测，探索结构化数据与语义建模之间的连接。</p></div></AxiSection><AxiSection title="教育与经历" id="education"><div class="axi-education-list">{education.map((item) => <a class="axi-education-card" href={item.link} target="_blank" rel="noreferrer"><div><h3>{item.title[locale]}</h3><p>{item.detail[locale]}</p></div><time>{item.period}</time><span>↗</span></a>)}</div></AxiSection><AxiSection title="研究方向" id="research"><div class="axi-research-list">{researchInterests.map((item) => <span>{item[locale]}</span>)}</div></AxiSection><AxiSection title="联系我" id="contact"><div class="axi-contact"><p>欢迎围绕图学习、事件序列预测、大模型、Agent 与科研合作交流。</p><a class="button button-primary" href={`mailto:${profile.email}`}>{profile.email} ↗</a></div></AxiSection></Layout>
