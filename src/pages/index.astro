---
import { Image } from 'astro:assets'
import { Button, Card, Icon, Label } from '@/components/user'
import GitHubActivityCalendar from '@/components/home/GitHubActivityCalendar.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import BlogStats from '@/components/home/BlogStats.astro'
import avatar from '@/assets/avatar.png'
import config from '@/site-config'
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB966'>
  <main class='flex w-full flex-col items-center'>
    <section class='relative animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <svg class='research-watermark pointer-events-none absolute -inset-x-24 -top-12 -z-10 h-72 w-[calc(100%+12rem)] opacity-[0.06]' viewBox='0 0 960 280' fill='none' aria-hidden='true'>
        <path d='M72 180 230 74l146 96 166-112 154 96 124-71' stroke='currentColor' stroke-width='1.2' stroke-dasharray='4 9' />
        <path d='M72 180 192 222l184-52 166 38 154-96 124 72' stroke='currentColor' stroke-width='1.2' />
        <g fill='currentColor'>
          <circle cx='72' cy='180' r='5' /><circle cx='230' cy='74' r='5' /><circle cx='376' cy='170' r='5' /><circle cx='542' cy='58' r='5' /><circle cx='696' cy='154' r='5' /><circle cx='820' cy='83' r='5' />
        </g>
      </svg>
      <div class='flex flex-row items-center gap-x-6'>
        <Image src={avatar} alt='profile' class='h-36 w-auto rounded-lg border p-1' loading='eager' />
        <div class='flex flex-col gap-y-4'>
          <h1 class='text-3xl font-bold'>{config.author}</h1>
          <div class='flex flex-wrap gap-x-1 gap-y-1'>
            {config.personal?.location && <Label title={config.personal.location}><Icon name='location' class='size-4' slot='icon' /></Label>}
            {config.personal?.githubUsername && <Label title='Github' as='a' href={`https://github.com/${config.personal.githubUsername}`} target='_blank' rel='noopener noreferrer'><Icon name='github' class='size-4' slot='icon' /></Label>}
            {config.personal?.email && <Label title='Email' as='a' href={`mailto:${config.personal.email}`}><Icon name='email' class='size-4' slot='icon' /></Label>}
            {config.personal?.googleScholar && <Label title='Scholar' as='a' href={config.personal.googleScholar}><Icon name='earth' class='size-4' slot='icon' /></Label>}
          </div>
          <nav class='flex flex-wrap items-center gap-2 text-xs' aria-label='Quick links'>
            {config.personal?.githubUsername && <a class='quick-link' href={`https://github.com/${config.personal.githubUsername}`} target='_blank' rel='noopener noreferrer'><Icon name='github' class='size-3.5' /><span>GitHub</span></a>}
            {config.personal?.email && <a class='quick-link' href={`mailto:${config.personal.email}`}><Icon name='email' class='size-3.5' /><span>Email</span></a>}
            <a class='quick-link' href='/academic'><Icon name='document' class='size-3.5' /><span>Academic</span></a>
          </nav>
        </div>
      </div>

      <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
        <Section title='About'>
          <p class='text-muted-foreground'>你好，我是罗锦辉，目前在湖南科技大学学习数据科学与大数据技术，并进入东南大学硕士阶段。我关注图数据、图神经网络、大语言模型、智能体与事件序列预测。</p>
          <Button title='More about me' class='w-fit self-end' href='/about' style='ahead' />
        </Section>
        <Section title='Education'>
          <Card as='a' heading='东南大学 · 硕士阶段' subheading='图数据与智能系统' date='2026' href='https://www.seu.edu.cn/' />
          <Card as='a' heading='湖南科技大学 · 数据科学与大数据技术' subheading='计算机科学与工程学院' date='2023 - 2027' href='https://computer.hnust.edu.cn/' />
          <Card as='a' heading='服务计算与软件服务新技术重点实验室' subheading='本科生研究成员 · 康国胜教授' date='2024 - Present' href='https://guoshengkang.github.io/' />
        </Section>
        <Section title='Statistics'>
          <BlogStats blogStartDate={new Date(config.personal?.blogStartDate || '2026-04-14')} />
          <div class='mt-1 flex flex-wrap items-center gap-2 text-sm text-muted-foreground'>
            <span class='rounded-full bg-primary/10 px-3 py-1 font-medium text-primary'>研究状态</span>
            <span>研0 · 开放学术交流</span>
            <span class='text-muted-foreground/60'>·</span>
            <span>持续更新</span>
          </div>
        </Section>
        {config.personal?.githubUsername && <GitHubActivityCalendar username={config.personal.githubUsername} />}
      </div>
    </section>
  </main>
</PageLayout>

<style>
  .quick-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid hsl(var(--border) / 0.7);
    border-radius: 9999px;
    background: hsl(var(--muted) / 0.45);
    padding: 0.3rem 0.65rem;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .quick-link:hover,
  .quick-link:focus-visible {
    border-color: hsl(var(--primary) / 0.45);
    background: hsl(var(--primary) / 0.1);
    color: hsl(var(--primary));
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-link { transition: none; }
  }

  .research-watermark {
    transform-origin: center;
    animation: research-watermark-drift 18s ease-in-out infinite alternate;
  }

  @keyframes research-watermark-drift {
    from { transform: translate3d(-0.5%, 0, 0) scale(1); }
    to { transform: translate3d(0.5%, 1%, 0) scale(1.015); }
  }

  @media (prefers-reduced-motion: reduce) {
    .research-watermark { animation: none; }
  }
</style>
