---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import SponsorshipSection from '@/components/projects/SponsorshipSection.astro'

const headings = [
  { depth: 2, slug: 'projects', text: 'Projects' },
  { depth: 2, slug: 'sponsorship', text: '赞助' }
]
---

<PageLayout title='Projects' {headings} info={{ slug: '/projects', hideComment: true }}>
  <p class='text-muted-foreground'>从研究原型到可复现系统，记录我如何把想法变成实验。</p>
  <h2 id='projects' class='mb-8 text-2xl font-semibold'>Projects</h2>
  <ProjectSection
    project={[
      {
        name: '望舌观体：多平台智能中医舌诊框架',
        description: '结合 D-FINE、SAM2 和特征引导体质分析，探索移动辅助中医舌诊。',
        links: [
          { type: 'site', href: 'https://github.com/Jinhui524' },
          { type: 'github', href: 'https://github.com/Jinhui524' }
        ]
      }
    ]}
  />
  <SponsorshipSection
    title='赞助'
    description='如果我的研究与开源工作对你有所帮助，欢迎留下支持。二维码会在后续更新。'
    emptyMessage='目前还没有赞助记录，感谢每一份关注与支持。'
    methods={[
      { name: '微信', label: '微信赞助', placeholder: '二维码待补充' },
      { name: '支付宝', label: '支付宝赞助', placeholder: '二维码待补充' }
    ]}
  />
</PageLayout>
