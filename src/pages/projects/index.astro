---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import AxiSection from '../../components/AxiSection.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { i18n } from '../../data/site';
const locale = 'zh';
const projects = await getCollection('projects');
---
<Layout locale={locale} title={i18n[locale].selectedProjects} wide><AxiSection title={i18n[locale].selectedProjects} id="projects"><p class="axi-page-lead">从研究原型到可复现系统，记录我如何把想法变成实验。</p><div class="project-list axi-archive-projects">{projects.map((project) => <ProjectCard project={project} locale={locale} />)}</div></AxiSection></Layout>
