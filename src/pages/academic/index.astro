---
import PageLayout from '@/layouts/CommonPage.astro'
import { Button, Icon, PublicationSection, SimpleIcon } from '@/components/user'
import { getLocalizedPublications } from '@/data/academic'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'education', text: 'Education & Experience' },
  { depth: 2, slug: 'research-interests', text: 'Research Interests' },
  { depth: 2, slug: 'publications', text: 'Publications' },
  { depth: 2, slug: 'awards', text: 'Awards' }
]

const education = [
  {
    period: '2026 — Present',
    title: 'Southeast University · incoming',
    subtitle: 'School of Computer Science and Engineering · Data and intelligent systems',
    role: 'Incoming graduate student',
    href: 'https://cse.seu.edu.cn/'
  },
  {
    period: '2023 — 2027',
    title: 'Hunan University of Science and Technology',
    subtitle: 'Data Science and Big Data Technology',
    role: 'Undergraduate student',
    href: 'https://computer.hnust.edu.cn/'
  },
  {
    period: '2024 — Present',
    title: 'Key Laboratory of Service Computing and New Software Technology',
    subtitle: 'Research on graph data, process intelligence and foundation models',
    role: 'Student researcher · Prof. Guosheng Kang',
    href: 'https://guoshengkang.github.io/'
  }
]

const publications = getLocalizedPublications('zh')

const awards = [
  {
    title: '竞赛与工程实践',
    items: ['第七届传智杯全国 IT 技能大赛编程挑战赛二等奖。', '2025 RAICOM 机器人开发者大赛编程技能赛道三等奖。', '2026 RAICOM 机器人开发者大赛智海算法优化赛道一等奖。']
  },
  {
    title: '算法与人工智能',
    items: ['第二十八届中国机器人及人工智能大赛湖南赛区一等奖。', '第二十一届湖南省大学生程序设计竞赛一等奖。', '第十六届蓝桥杯软件和信息技术人才大赛二等奖。']
  }
]
---

<PageLayout title='Academic' {headings} info={{ slug: '/academic', hideComment: true }}>
  <h2 id='about-me'>About Me<a class='anchor' href='#about-me'>#</a></h2>
  <p>
    我是湖南科技大学数据科学与大数据技术专业本科生，并进入东南大学硕士阶段（研0）。目前在湖南省服务计算与软件服务新技术重点实验室开展研究，导师为康国胜教授。
  </p>
  <p>
    我的研究关注图数据挖掘、图神经网络、大语言模型、智能体与事件序列预测，探索结构化数据与语义建模之间的连接。
  </p>
  <Button title='GitHub profile' class='w-fit' href='https://github.com/Jinhui524' target='_blank' rel='noopener noreferrer'>
    <Icon class='size-5' name='github' slot='before' />
  </Button>

  <h2 id='education'>Education &amp; Experience<a class='anchor' href='#education'>#</a></h2>
  <div class='academic-timeline space-y-3'>
    {education.map((item, index) => (
      <a class='academic-education-card group' href={item.href} target='_blank' rel='noopener noreferrer'>
        <span class='academic-education-index'>{String(index + 1).padStart(2, '0')}</span>
        <span class='min-w-0 flex-1'>
          <span class='mb-1 flex flex-wrap items-center gap-2'>
            <strong class='text-base text-foreground transition-colors group-hover:text-primary'>{item.title}</strong>
            <span class='academic-role'>{item.role}</span>
          </span>
          <span class='block text-sm text-muted-foreground'>{item.subtitle}</span>
        </span>
        <time class='shrink-0 text-xs text-muted-foreground'>{item.period}</time>
      </a>
    ))}
  </div>

  <h2 id='research-interests'>Research Interests<a class='anchor' href='#research-interests'>#</a></h2>
  <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
    {[
      ['图数据挖掘', 'Graph data mining', 'ros'],
      ['图神经网络', 'Graph neural networks', 'pytorch'],
      ['大语言模型', 'Large language models', 'chatgpt'],
      ['智能体 Agent', 'AI agents', 'openai'],
      ['事件序列预测', 'Event sequence prediction', 'timeline'],
      ['结构化语义建模', 'Structured semantic modeling', 'document']
    ].map(([title, description, icon]) => (
      <div class='group relative overflow-hidden rounded-xl border border-border bg-card p-4 transition-all hover:-translate-y-0.5 hover:border-foreground/25 hover:shadow-md'>
        <div class='flex items-start gap-4'>
          <div class='flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/20'>
            <SimpleIcon class='size-5 text-primary transition-transform duration-300 group-hover:scale-110' name={icon} />
          </div>
          <div class='flex-1'>
            <p class='text-xl font-medium leading-tight text-foreground transition-colors group-hover:text-primary'>{title}</p>
            <p class='text-sm leading-relaxed text-muted-foreground'>{description}</p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <h2 id='publications'>Publications<a class='anchor' href='#publications'>#</a></h2>
  <div data-publication-filter class='mb-5 flex flex-wrap items-center gap-2' role='group' aria-label='Publication filters'>
    <span class='mr-1 text-sm text-muted-foreground'>Filter:</span>
    {[
      ['all', 'All'],
      ['conference', 'Conference'],
      ['journal', 'Journal'],
      ['under-review', 'Under Review']
    ].map(([value, label], index) => (
      <button type='button' data-filter={value} aria-pressed={index === 0 ? 'true' : 'false'} class:list-active={index === 0} class='publication-filter-button'>{label}</button>
    ))}
    <span class='ml-auto text-xs text-muted-foreground' data-publication-count>{publications.length} publications</span>
  </div>
  <div class='space-y-6' data-publication-list>
    {publications.map((publication) => (
      <div class='publication-entry' data-publication-entry data-type={publication.type} data-status={publication.status}>
        <PublicationSection publications={[publication]} groupByYear={false} />
      </div>
    ))}
  </div>
  <div id='academic-toast' class='academic-toast' aria-live='polite' aria-atomic='true'></div>

  <h2 id='awards'>Awards<a class='anchor' href='#awards'>#</a></h2>
  <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
    {awards.map((group, index) => (
      <section class='rounded-xl border border-border bg-card p-5'>
        <div class='mb-4 flex items-center gap-3'>
          <span class='academic-award-index'>{String(index + 1).padStart(2, '0')}</span>
          <h3 class='m-0 text-lg font-semibold text-foreground'>{group.title}</h3>
        </div>
        <ul class='m-0 space-y-2 pl-5 text-sm leading-relaxed text-muted-foreground'>
          {group.items.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    ))}
  </div>
</PageLayout>

<script is:inline>
  const filterRoot = document.querySelector('[data-publication-filter]')
  const publicationEntries = Array.from(document.querySelectorAll('[data-publication-entry]'))
  const countLabel = document.querySelector('[data-publication-count]')
  const toast = document.querySelector('#academic-toast')
  let toastTimer

  const showToast = (message) => {
    if (!toast) return
    toast.textContent = message
    toast.classList.add('is-visible')
    clearTimeout(toastTimer)
    toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1800)
  }

  filterRoot?.querySelectorAll('button[data-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter') || 'all'
      let visibleCount = 0
      publicationEntries.forEach((entry) => {
        const matches = filter === 'all' || entry.dataset.type === filter || entry.dataset.status === filter
        entry.toggleAttribute('hidden', !matches)
        if (matches) visibleCount += 1
      })
      filterRoot.querySelectorAll('button[data-filter]').forEach((item) => {
        const active = item === button
        item.setAttribute('aria-pressed', String(active))
        item.classList.toggle('list-active', active)
      })
      if (countLabel) countLabel.textContent = `${visibleCount} publications`
      showToast(filter === 'all' ? 'Showing all publications' : `Showing ${button.textContent}`)
    })
  })
</script>

<style>
  .academic-news-row,
  .academic-education-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 0.75rem;
    padding: 0.75rem;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .academic-news-row:hover,
  .academic-education-card:hover {
    background-color: color-mix(in srgb, var(--color-muted) 65%, transparent);
    transform: translateX(2px);
  }

  .academic-status,
  .academic-role,
  .research-tag,
  .academic-award-index {
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
    padding: 0.35rem 0.55rem;
  }

  .academic-status,
  .academic-role {
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
  }

  .research-tag {
    background: color-mix(in srgb, var(--color-muted) 80%, transparent);
    color: var(--color-muted-foreground);
  }

  .academic-education-card {
    position: relative;
    border: 1px solid var(--color-border);
    background: var(--color-card);
  }

  .academic-education-index,
  .academic-award-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .publication-filter-button {
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: var(--color-card);
    color: var(--color-muted-foreground);
    cursor: pointer;
    font-size: 0.75rem;
    padding: 0.4rem 0.7rem;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .publication-filter-button:hover,
  .publication-filter-button.list-active {
    border-color: color-mix(in srgb, var(--color-primary) 50%, var(--color-border));
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
  }

  .publication-filter-button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .publication-entry[hidden] {
    display: none;
  }

  .academic-toast {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-card);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.12);
    color: var(--color-foreground);
    font-size: 0.8rem;
    opacity: 0;
    padding: 0.65rem 0.85rem;
    pointer-events: none;
    transform: translateY(0.5rem);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .academic-toast.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .academic-news-row,
    .academic-education-card {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .academic-news-row > :nth-child(3),
    .academic-education-card > :nth-child(2) {
      flex-basis: calc(100% - 3rem);
    }

    .academic-news-row > :last-child,
    .academic-education-card > :last-child {
      margin-left: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .academic-news-row,
    .academic-education-card,
    .academic-toast,
    .publication-filter-button {
      transition: none;
    }
  }
</style>
