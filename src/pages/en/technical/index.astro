---
import { getCollection } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import AxiSection from '../../../components/AxiSection.astro';
import { i18n } from '../../../data/site';
const locale = 'en';
const notes = await getCollection('notes');
---
<Layout locale={locale} title={i18n[locale].technicalTitle} wide><AxiSection title={i18n[locale].technicalTitle} id="technical"><p class="axi-page-lead">AI roadmaps, graph neural networks, foundation models, agents, and experiments.</p><div class="axi-article-list">{notes.map((note) => <a class="axi-archive-row" href={`/en/technical/${note.data.slug}/`}><span class="axi-archive-row__meta">{note.data.date} · Technical</span><strong>{note.data.titleEn}</strong><p>{note.data.excerptEn}</p><span class="text-link">Read technical note ↗</span></a>)}</div></AxiSection></Layout>
