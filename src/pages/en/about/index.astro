---
import PageLayout from '@/layouts/CommonPage.astro'
import config from '@/site-config'
import ToolSection from '@/components/about/ToolSection.astro'
import AlgorithmShowcase from '@/components/about/AlgorithmShowcase.astro'
import { getAwardGroups } from '@/data/awards'

const tools = [
  {
    name: 'VS Code',
    description: 'Code Editor',
    href: 'https://code.visualstudio.com/',
    icon: import('@/assets/tools/vscode.svg?raw')
  },
  {
    name: 'Cursor',
    description: 'AI-powered Code Editor',
    href: 'https://www.cursor.com/',
    icon: import('@/assets/tools/cursor.svg?raw')
  },
  {
    name: 'Chrome',
    description: 'Web Browser',
    href: 'https://www.google.com/chrome/',
    icon: import('@/assets/tools/chrome.svg?raw')
  },
  {
    name: 'Ubuntu',
    description: 'Linux Distribution',
    href: 'https://ubuntu.com/',
    icon: import('@/assets/tools/ubuntu.svg?raw')
  }
]

const headings = [
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'research', text: 'Research Interests' },
  { depth: 2, slug: 'awards', text: 'Awards' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'theme', text: 'Theme' },
  { depth: 2, slug: 'copyright', text: 'Copyright' }
]

const awards = getAwardGroups('en')
---

<PageLayout title='About' {headings} info='/en/about'>
  <p>Data science student / Researcher in graph learning and event sequences</p>
  <p>
    I am Jinhui Luo, an undergraduate student at Hunan University of Science and Technology and an incoming graduate student at Southeast University’s School of Computer Science and Engineering. I conduct research with the Hunan Provincial Key Laboratory of Service Computing and New Software Technology.
  </p>
  <p>
    My work connects graph data mining, graph neural networks, foundation models, AI agents, and event sequence prediction through structured, reproducible experiments.
  </p>

  <h2 id='education'>Education<a class='anchor' href='#education'>#</a></h2>
  <ul>
    <li><strong><a href='https://cse.seu.edu.cn/' target='_blank' rel='noopener noreferrer'>Southeast University School of Computer Science and Engineering</a></strong> · Incoming graduate student, 2026</li>
    <li><strong>Hunan University of Science and Technology</strong> · Data Science and Big Data Technology, 2023—2027</li>
    <li><strong>Hunan Provincial Key Laboratory of Service Computing and New Software Technology</strong> · Undergraduate research member, 2024—present</li>
  </ul>

  <h2 id='research'>Research Interests<a class='anchor' href='#research'>#</a></h2>
  <p>Graph data mining · Graph neural networks · Foundation models · AI agents · Event sequence prediction · Structured semantic modeling</p>

  <h2 id='awards'>Awards<a class='anchor' href='#awards'>#</a></h2>
  <div class='not-prose about-awards-grid'>
    {awards.map((group, index) => (
      <section class='about-award-card'>
        <div class='about-award-heading'>
          <span class='about-award-index'>{String(index + 1).padStart(2, '0')}</span>
          <h3>{group.title}</h3>
        </div>
        <ul class='about-award-list'>
          {group.items.map((item) => (
            <li class='about-award-item'>
              <time class='about-award-date'>{item.date}</time>
              <span class='about-award-title'>{item.title}</span>
              <span class='about-award-category'>{item.category}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <h2 id='tools'>🧰 Tools<a class='anchor' href='#tools'>#</a></h2>
  <ToolSection title='Productivity' {tools} />

  <h2 id='theme'>🎨 Theme<a class='anchor' href='#theme'>#</a></h2>
  <p>
    This site is built with Astro and tailored for research reading, discovery, and project presentation. The small interactive sketches below reflect my interest in visualization and thoughtful interface details.
  </p>
  <AlgorithmShowcase />

  <h2 id='copyright'>📄 Copyright<a class='anchor' href='#copyright'>#</a></h2>
  <p>
    Unless otherwise noted, original profile copy, research materials, and design work are created by Jinhui Luo and released under the
    <a href='https://creativecommons.org/licenses/by-nc-sa/4.0/' target='_blank' rel='noopener noreferrer'>
      CC BY-NC-SA 4.0
    </a>
    license. You may share and adapt this material with attribution, for non-commercial purposes, and under the same license.
  </p>
  <p>
    Third-party images, logos, fonts, icons, and open-source code remain the property of their respective rights holders and are used under their applicable licenses. Please contact me if you believe any material infringes your rights.
  </p>
  <p class='not-prose flex justify-center py-2'>
    <a href='https://creativecommons.org/licenses/by-nc-sa/4.0/' target='_blank' rel='noopener noreferrer' aria-label='Creative Commons BY-NC-SA 4.0 license'>
      <img src='/images/licenses/cc-by-nc-sa.svg' alt='Creative Commons BY-NC-SA 4.0' width='88' height='31' loading='lazy' />
    </a>
  </p>
  <p>Contact: <a href={`mailto:${config.personal?.email}`}>{config.personal?.email}</a></p>
</PageLayout>

<style>
  .about-awards-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin:1.5rem 0 2.5rem; }
  .about-award-card { border:1px solid var(--color-border); border-radius:.75rem; background:var(--color-card); padding:1.25rem; }
  .about-award-heading { display:flex; align-items:center; gap:.75rem; margin-bottom:1rem; }
  .about-award-heading h3 { margin:0; color:var(--color-foreground); font-size:1.125rem; font-weight:600; }
  .about-award-index { display:inline-flex; align-items:center; justify-content:center; width:2rem; height:2rem; border-radius:.625rem; background:color-mix(in srgb,var(--color-primary) 12%,transparent); color:var(--color-primary); font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.7rem; font-weight:600; }
  .about-award-list { display:grid; gap:.75rem; margin:0; padding:0; list-style:none; }
  .about-award-item { display:grid; grid-template-columns:auto minmax(0,1fr); align-items:start; gap:.35rem .75rem; color:var(--color-muted-foreground); font-size:.875rem; line-height:1.5; }
  .about-award-date { color:var(--color-muted-foreground); font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.72rem; white-space:nowrap; }
  .about-award-title { min-width:0; color:var(--color-foreground); }
  .about-award-category { grid-column:2; justify-self:start; border-radius:9999px; background:color-mix(in srgb,var(--color-primary) 10%,transparent); color:var(--color-primary); font-size:.6875rem; font-weight:600; line-height:1; padding:.35rem .55rem; white-space:nowrap; }
  @media (max-width:640px) { .about-awards-grid { grid-template-columns:1fr; } }
</style>
