---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import SponsorshipSection from '@/components/projects/SponsorshipSection.astro'

const headings = [
  { depth: 2, slug: 'projects', text: 'Projects' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} info={{ slug: '/en/projects', hideComment: true }}>
  <p class='text-muted-foreground'>Research prototypes and reproducible systems built from ideas.</p>
  <h2 id='projects' class='mb-8 text-2xl font-semibold'>Projects</h2>
  <ProjectSection
    project={[
      {
        name: 'Wangshe Guanti: Intelligent TCM Tongue Diagnosis Framework',
        description: 'A multi-platform tongue diagnosis system combining D-FINE, SAM2, and feature-guided constitution analysis.',
        links: [
          { type: 'site', href: 'https://github.com/Jinhui524' },
          { type: 'github', href: 'https://github.com/Jinhui524' }
        ]
      }
    ]}
  />
  <SponsorshipSection
    title='Sponsorship'
    description='If my research and open-source work helps you, you are welcome to leave a note of support. QR codes will be added later.'
    emptyMessage='No sponsorship records yet. Thank you for every bit of attention and support.'
    sponsorTitle='Sponsors'
    methods={[
      { name: 'WeChat', label: 'WeChat sponsorship', placeholder: 'QR code coming soon' },
      { name: 'Alipay', label: 'Alipay sponsorship', placeholder: 'QR code coming soon' }
    ]}
  />
</PageLayout>
