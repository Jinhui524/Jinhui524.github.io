---
import { getCollection } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import AxiSection from '../../../components/AxiSection.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { i18n } from '../../../data/site';
const locale = 'en';
const projects = await getCollection('projects');
---
<Layout locale={locale} title={i18n[locale].selectedProjects} wide><AxiSection title={i18n[locale].selectedProjects} id="projects"><p class="axi-page-lead">Research prototypes and reproducible systems built from ideas.</p><div class="project-list axi-archive-projects">{projects.map((project) => <ProjectCard project={project} locale={locale} />)}</div></AxiSection></Layout>
