---
import PageLayout from '@/layouts/CommonPage.astro'
import { Button, Icon, PublicationSection, SimpleIcon } from '@/components/user'
import { getLocalizedPublications } from '@/data/academic'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'education', text: 'Education & Experience' },
  { depth: 2, slug: 'research-interests', text: 'Research Interests' },
  { depth: 2, slug: 'publications', text: 'Publications' },
  { depth: 2, slug: 'awards', text: 'Awards' }
]

const education = [
  { period: '2026 — Present', title: 'Southeast University · Incoming', subtitle: 'School of Computer Science and Engineering · Data and intelligent systems', role: 'Incoming graduate student', href: 'https://cse.seu.edu.cn/' },
  { period: '2023 — 2027', title: 'Hunan University of Science and Technology', subtitle: 'Data Science and Big Data Technology', role: 'Undergraduate student', href: 'https://computer.hnust.edu.cn/' },
  { period: '2024 — Present', title: 'Key Laboratory of Service Computing and New Software Technology', subtitle: 'Graph data, process intelligence and foundation models', role: 'Student researcher · Prof. Guosheng Kang', href: 'https://guoshengkang.github.io/' }
]

const publications = getLocalizedPublications('en')

const awards = [
  { title: 'Competitions and engineering', items: ['Second Prize, Chuanzhi Cup National IT Skills Competition.', 'Third Prize, 2025 RAICOM Robotics Developer Competition.', 'First Prize, 2026 RAICOM Algorithm Optimization Competition.'] },
  { title: 'Algorithms and AI', items: ['First Prize, China Robot and Artificial Intelligence Competition, Hunan.', 'First Prize, Hunan Provincial Collegiate Programming Contest.', 'Second Prize, Lanqiao Cup Software and Information Technology Competition.'] }
]
---

<PageLayout title='Academic' {headings} info={{ slug: '/en/academic', hideComment: true }}>
  <h2 id='about-me'>About Me<a class='anchor' href='#about-me'>#</a></h2>
  <p>I am a data science student at Hunan University of Science and Technology and a graduate student at Southeast University. I conduct research with the Hunan Provincial Key Laboratory of Service Computing and New Software Technology.</p>
  <p>My work connects graph data mining, graph neural networks, foundation models, AI agents, and event sequence prediction.</p>
  <Button title='GitHub profile' class='w-fit' href='https://github.com/Jinhui524' target='_blank' rel='noopener noreferrer'><Icon class='size-5' name='github' slot='before' /></Button>

  <h2 id='education'>Education &amp; Experience<a class='anchor' href='#education'>#</a></h2>
  <div class='academic-timeline space-y-3'>
    {education.map((item, index) => <a class='academic-education-card group' href={item.href} target='_blank' rel='noopener noreferrer'><span class='academic-education-index'>{String(index + 1).padStart(2, '0')}</span><span class='min-w-0 flex-1'><span class='mb-1 flex flex-wrap items-center gap-2'><strong class='text-base text-foreground transition-colors group-hover:text-primary'>{item.title}</strong><span class='academic-role'>{item.role}</span></span><span class='block text-sm text-muted-foreground'>{item.subtitle}</span></span><time class='shrink-0 text-xs text-muted-foreground'>{item.period}</time></a>)}
  </div>

  <h2 id='research-interests'>Research Interests<a class='anchor' href='#research-interests'>#</a></h2>
  <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
    {[['Graph Data Mining', 'Mining structure from complex data', 'ros'], ['Graph Neural Networks', 'Learning over relational structure', 'pytorch'], ['Foundation Models', 'Language models for process intelligence', 'openai'], ['AI Agents', 'Tool-using intelligent systems', 'github'], ['Event Sequences', 'Predictive process monitoring', 'calendar'], ['Semantic Modeling', 'Structured representations and reasoning', 'document']].map(([title, description, icon]) => <div class='group relative overflow-hidden rounded-xl border border-border bg-card p-4 transition-all hover:-translate-y-0.5 hover:border-foreground/25 hover:shadow-md'><div class='flex items-start gap-4'><div class='flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10'><SimpleIcon class='size-5 text-primary' name={icon} /></div><div class='flex-1'><p class='text-xl font-medium leading-tight text-foreground'>{title}</p><p class='text-sm leading-relaxed text-muted-foreground'>{description}</p></div></div></div>)}
  </div>

  <h2 id='publications'>Publications<a class='anchor' href='#publications'>#</a></h2>
  <div data-publication-filter class='mb-5 flex flex-wrap items-center gap-2' role='group' aria-label='Publication filters'><span class='mr-1 text-sm text-muted-foreground'>Filter:</span>{[['all', 'All'], ['conference', 'Conference'], ['journal', 'Journal'], ['under-review', 'Under Review']].map(([value, label], index) => <button type='button' data-filter={value} aria-pressed={index === 0 ? 'true' : 'false'} class:list-active={index === 0} class='publication-filter-button'>{label}</button>)}<span class='ml-auto text-xs text-muted-foreground' data-publication-count>{publications.length} publications</span></div>
  <div class='space-y-6' data-publication-list>{publications.map((publication) => <div class='publication-entry' data-publication-entry data-type={publication.type} data-status={publication.status}><PublicationSection publications={[publication]} groupByYear={false} /></div>)}</div>
  <div id='academic-toast' class='academic-toast' aria-live='polite' aria-atomic='true'></div>

  <h2 id='awards'>Awards<a class='anchor' href='#awards'>#</a></h2>
  <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>{awards.map((group, index) => <section class='rounded-xl border border-border bg-card p-5'><div class='mb-4 flex items-center gap-3'><span class='academic-award-index'>{String(index + 1).padStart(2, '0')}</span><h3 class='m-0 text-lg font-semibold text-foreground'>{group.title}</h3></div><ul class='m-0 space-y-2 pl-5 text-sm leading-relaxed text-muted-foreground'>{group.items.map((item) => <li>{item}</li>)}</ul></section>)}</div>
</PageLayout>

<script is:inline>
  const filterRoot = document.querySelector('[data-publication-filter]')
  const entries = Array.from(document.querySelectorAll('[data-publication-entry]'))
  const count = document.querySelector('[data-publication-count]')
  const toast = document.querySelector('#academic-toast')
  let timer
  const notify = (message) => { if (!toast) return; toast.textContent = message; toast.classList.add('is-visible'); clearTimeout(timer); timer = window.setTimeout(() => toast.classList.remove('is-visible'), 1800) }
  filterRoot?.querySelectorAll('button[data-filter]').forEach((button) => button.addEventListener('click', () => { const filter = button.dataset.filter || 'all'; let visible = 0; entries.forEach((entry) => { const match = filter === 'all' || entry.dataset.type === filter || entry.dataset.status === filter; entry.toggleAttribute('hidden', !match); if (match) visible += 1 }); filterRoot.querySelectorAll('button[data-filter]').forEach((item) => { const active = item === button; item.setAttribute('aria-pressed', String(active)); item.classList.toggle('list-active', active) }); if (count) count.textContent = `${visible} publications`; notify(filter === 'all' ? 'Showing all publications' : `Showing ${button.textContent}`) }))
</script>

<style>
  .academic-news-row, .academic-education-card { display:flex; align-items:center; gap:.75rem; border-radius:.75rem; padding:.75rem; transition:background-color 180ms ease, transform 180ms ease; }
  .academic-news-row:hover, .academic-education-card:hover { background-color:color-mix(in srgb,var(--color-muted) 65%,transparent); transform:translateX(2px); }
  .academic-status, .academic-role, .research-tag, .academic-award-index { border-radius:9999px; font-size:.6875rem; font-weight:600; letter-spacing:.01em; line-height:1; padding:.35rem .55rem; }
  .academic-status, .academic-role { background:color-mix(in srgb,var(--color-primary) 12%,transparent); color:var(--color-primary); }
  .research-tag { background:color-mix(in srgb,var(--color-muted) 80%,transparent); color:var(--color-muted-foreground); }
  .academic-education-card { position:relative; border:1px solid var(--color-border); background:var(--color-card); }
  .academic-education-index, .academic-award-index { display:inline-flex; align-items:center; justify-content:center; flex:0 0 auto; width:2rem; height:2rem; border-radius:.625rem; background:color-mix(in srgb,var(--color-primary) 12%,transparent); color:var(--color-primary); font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.7rem; font-weight:600; }
  .publication-filter-button { border:1px solid var(--color-border); border-radius:9999px; background:var(--color-card); color:var(--color-muted-foreground); cursor:pointer; font-size:.75rem; padding:.4rem .7rem; transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease; }
  .publication-filter-button:hover, .publication-filter-button.list-active { border-color:color-mix(in srgb,var(--color-primary) 50%,var(--color-border)); background:color-mix(in srgb,var(--color-primary) 12%,transparent); color:var(--color-primary); }
  .publication-filter-button:focus-visible { outline:2px solid var(--color-primary); outline-offset:2px; }
  .publication-entry[hidden] { display:none; }
  .academic-toast { position:fixed; right:1rem; bottom:1rem; z-index:40; border:1px solid var(--color-border); border-radius:.75rem; background:var(--color-card); box-shadow:0 12px 30px rgb(0 0 0 / .12); color:var(--color-foreground); font-size:.8rem; opacity:0; padding:.65rem .85rem; pointer-events:none; transform:translateY(.5rem); transition:opacity 180ms ease,transform 180ms ease; }
  .academic-toast.is-visible { opacity:1; transform:translateY(0); }
  @media (max-width:640px) { .academic-news-row,.academic-education-card { align-items:flex-start; flex-wrap:wrap; } .academic-news-row > :nth-child(3),.academic-education-card > :nth-child(2) { flex-basis:calc(100% - 3rem); } .academic-news-row > :last-child,.academic-education-card > :last-child { margin-left:3rem; } }
  @media (prefers-reduced-motion:reduce) { .academic-news-row,.academic-education-card,.academic-toast,.publication-filter-button { transition:none; } }
</style>
