---
import { getCollection } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import AxiSection from '../../../components/AxiSection.astro';
import { i18n } from '../../../data/site';
const locale = 'en';
const notes = await getCollection('notes');
---
<Layout locale={locale} title={i18n[locale].researchTitle} wide><AxiSection title={i18n[locale].researchTitle} id="research"><p class="axi-page-lead">Research notes on graph data, event sequences, foundation models, and agents.</p><div class="axi-article-list">{notes.map((note) => <a class="axi-archive-row" href={`/en/research/${note.data.slug}/`}><span class="axi-archive-row__meta">{note.data.date} · Research</span><strong>{note.data.titleEn}</strong><p>{note.data.excerptEn}</p><span class="text-link">Read research note ↗</span></a>)}</div></AxiSection></Layout>
