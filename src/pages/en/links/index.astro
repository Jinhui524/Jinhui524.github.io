---
import Layout from '../../../components/Layout.astro';
import AxiSection from '../../../components/AxiSection.astro';
import { linkGroups, i18n } from '../../../data/site';
const locale = 'en';
---
<Layout locale={locale} title={i18n[locale].linksTitle} wide><AxiSection title={i18n[locale].linksTitle} id="links"><p class="axi-page-lead">Academic, development, and learning paths worth visiting.</p>{linkGroups.map((group) => <section class="axi-link-group"><h3>{group.title[locale]}</h3><div class="link-grid">{group.items.map((item) => <a class="link-card" href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}><span class="link-card-mark">↗</span><strong>{item.name}</strong><p>{item.description[locale]}</p></a>)}</div></section>)}</AxiSection></Layout>
